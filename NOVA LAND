    <script>
        document.addEventListener('DOMContentLoaded', () => {
            /* 1. Mobile Menu Drawer Toggle */
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileDrawer = document.getElementById('mobileDrawer');
            const menuIconOpen = document.getElementById('menuIconOpen');
            const menuIconClose = document.getElementById('menuIconClose');
            const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

            function toggleMobileMenu(forceClose = false) {
                const isCurrentlyOpen = !mobileDrawer.classList.contains('hidden');
                const shouldOpen = forceClose ? false : !isCurrentlyOpen;

                if (shouldOpen) {
                    mobileDrawer.classList.remove('hidden');
                    menuIconOpen.classList.add('hidden');
                    menuIconClose.classList.remove('hidden');
                    mobileMenuBtn.setAttribute('aria-expanded', 'true');
                } else {
                    mobileDrawer.classList.add('hidden');
                    menuIconOpen.classList.remove('hidden');
                    menuIconClose.classList.add('hidden');
                    mobileMenuBtn.setAttribute('aria-expanded', 'false');
                }
            }

            mobileMenuBtn.addEventListener('click', () => toggleMobileMenu());

            mobileNavLinks.forEach((link) => {
                link.addEventListener('click', () => toggleMobileMenu(true));
            });

            /* 2. Portfolio "INQUIRE SIMILAR" Service Pre-selection */
            const projectTypeSelect = document.getElementById('projectType');
            const inquireButtons = document.querySelectorAll('.inquire-similar-btn');
            const enquiryForm = document.getElementById('enquiryForm');
            const enquiryConfirmation = document.getElementById('enquiryConfirmation');

            inquireButtons.forEach((btn) => {
                btn.addEventListener('click', () => {
                    const targetService = btn.getAttribute('data-service');
                    // Ensure form is visible in case a previous confirmation was active
                    enquiryConfirmation.classList.add('hidden');
                    enquiryForm.classList.remove('hidden');

                    if (targetService && projectTypeSelect) {
                        projectTypeSelect.value = targetService;
                    }
                });
            });

            /* 3. Interactive Project Enquiry Form Submission & Reset */
            const formError = document.getElementById('formError');
            const confirmedName = document.getElementById('confirmedName');
            const confirmedService = document.getElementById('confirmedService');
            const confirmedEmail = document.getElementById('confirmedEmail');
            const resetEnquiryBtn = document.getElementById('resetEnquiryBtn');

            enquiryForm.addEventListener('submit', (event) => {
                event.preventDefault();
                formError.classList.add('hidden');

                const nameValue = document.getElementById('clientName').value.trim();
                const emailValue = document.getElementById('clientEmail').value.trim();
                const serviceValue = projectTypeSelect.value;
                const detailsValue = document.getElementById('projectDetails').value.trim();

                // Validation checks
                if (!nameValue || !emailValue || !serviceValue || !detailsValue) {
                    formError.textContent = 'Please complete all required fields before submitting your enquiry.';
                    formError.classList.remove('hidden');
                    return;
                }

                const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailPattern.test(emailValue)) {
                    formError.textContent = 'Please enter a valid email address.';
                    formError.classList.remove('hidden');
                    return;
                }

                // Populate and display confirmation state
                const selectedOptionText = projectTypeSelect.options[projectTypeSelect.selectedIndex].text;
                confirmedName.textContent = nameValue;
                confirmedService.textContent = selectedOptionText;
                confirmedEmail.textContent = emailValue;

                enquiryForm.classList.add('hidden');
                enquiryConfirmation.classList.remove('hidden');
            });

            resetEnquiryBtn.addEventListener('click', () => {
                enquiryForm.reset();
                formError.classList.add('hidden');
                enquiryConfirmation.classList.add('hidden');
                enquiryForm.classList.remove('hidden');
            });
        });
    </script>
